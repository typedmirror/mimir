package platform

import "core:fmt"
import "core:mem"
import "core:os"

// Runtime shim generators for mimir.* virtual modules.
// Each generates Python code that provides real implementations matching type stubs.
// Used by `mimir run` to inject virtual modules into sys.modules before running user scripts.

// ==================== Bootstrap ====================

// Generate a complete bootstrap script that injects all virtual modules and runs the user's script.
generate_run_bootstrap :: proc(script: string, script_args: []string, allocator: mem.Allocator) -> string {
	buf := make([dynamic]u8, 0, 16384, allocator)

	// Header
	_rs_sb(&buf, "#!/usr/bin/env python3\n")
	_rs_sb(&buf, "'''mimir run bootstrap - generated by mimir'''\n")
	_rs_sb(&buf, "import sys, os, importlib.util\n")
	_rs_sb(&buf, "from types import ModuleType\n")
	_rs_sb(&buf, "\n")

	// Parent module
	_rs_sb(&buf, "# Inject mimir parent module\n")
	_rs_sb(&buf, "if 'mimir' not in sys.modules:\n")
	_rs_sb(&buf, "    _mimir = ModuleType('mimir')\n")
	_rs_sb(&buf, "    _mimir.__path__ = []\n")
	_rs_sb(&buf, "    sys.modules['mimir'] = _mimir\n")
	_rs_sb(&buf, "\n")

	// Set sys.argv to match direct execution
	_rs_sb(&buf, fmt.tprintf("sys.argv = ['%s'", _rs_escape_py_str(script)))
	for arg in script_args {
		_rs_sb(&buf, fmt.tprintf(", '%s'", _rs_escape_py_str(arg)))
	}
	_rs_sb(&buf, "]\n")
	_rs_sb(&buf, "\n")

	// Inject all virtual module shims
	_rs_sb(&buf, generate_db_shim(allocator))
	_rs_sb(&buf, generate_crypt_shim(allocator))
	_rs_sb(&buf, generate_json_shim(allocator))
	_rs_sb(&buf, generate_data_shim(allocator))
	_rs_sb(&buf, generate_actor_shim(allocator))

	// Run user script via importlib
	_rs_sb(&buf, "# Run user script\n")
	_rs_sb(&buf, fmt.tprintf("_script_dir = '%s'\n", _rs_escape_py_str(parent_dir(script))))
	_rs_sb(&buf, "if _script_dir not in sys.path:\n")
	_rs_sb(&buf, "    sys.path.insert(0, _script_dir)\n")
	_rs_sb(&buf, "\n")
	_rs_sb(&buf, fmt.tprintf("_script_path = '%s'\n", _rs_escape_py_str(script)))
	_rs_sb(&buf, "spec = importlib.util.spec_from_file_location('__main__', _script_path)\n")
	_rs_sb(&buf, "if spec is None or spec.loader is None:\n")
	_rs_sb(&buf, "    print(f'mimir run: failed to load {_script_path}', file=sys.stderr)\n")
	_rs_sb(&buf, "    sys.exit(1)\n")
	_rs_sb(&buf, "mod = importlib.util.module_from_spec(spec)\n")
	_rs_sb(&buf, "sys.modules['__main__'] = mod\n")
	_rs_sb(&buf, "spec.loader.exec_module(mod)\n")

	return string(buf[:])
}

// Write bootstrap content to a temp file. Returns path and success.
write_run_bootstrap :: proc(content: string, allocator: mem.Allocator) -> (path: string, ok: bool) {
	tmp_dir, tmp_err := os.temp_directory(allocator)
	if tmp_err != nil {
		tmp_dir = "/tmp"
	}

	pid := os.get_pid()
	boot_path := fmt.aprintf("%s/_mimir_run_%d.py", tmp_dir, pid, allocator = allocator)

	write_err := os.write_entire_file(boot_path, transmute([]u8)content)
	if write_err != nil {
		fmt.eprintfln("mimir run: failed to write bootstrap to %s: %v", boot_path, write_err)
		return "", false
	}

	return boot_path, true
}

// ==================== mimir.db shim ====================

generate_db_shim :: proc(allocator: mem.Allocator) -> string {
	buf := make([dynamic]u8, 0, 4096, allocator)

	_rs_sb(&buf, "# ---- mimir.db runtime shim ----\n")
	_rs_sb(&buf, "import sqlite3\n")
	_rs_sb(&buf, "from urllib.parse import urlparse\n")
	_rs_sb(&buf, "\n")

	// Connection class
	_rs_sb(&buf, "class _DB_Connection:\n")
	_rs_sb(&buf, "    def __init__(self, raw_conn, scheme):\n")
	_rs_sb(&buf, "        self._conn = raw_conn\n")
	_rs_sb(&buf, "        self._scheme = scheme\n")
	_rs_sb(&buf, "        self._in_tx = False\n")
	_rs_sb(&buf, "\n")
	_rs_sb(&buf, "    def query(self, sql, params=None, result=None):\n")
	_rs_sb(&buf, "        cur = self._conn.cursor()\n")
	_rs_sb(&buf, "        cur.execute(sql, params or ())\n")
	_rs_sb(&buf, "        cols = [d[0] for d in cur.description] if cur.description else []\n")
	_rs_sb(&buf, "        rows = [dict(zip(cols, row)) for row in cur.fetchall()]\n")
	_rs_sb(&buf, "        if result is not None:\n")
	_rs_sb(&buf, "            rows = [result(**r) for r in rows]\n")
	_rs_sb(&buf, "        return rows\n")
	_rs_sb(&buf, "\n")
	_rs_sb(&buf, "    def execute(self, sql, params=None):\n")
	_rs_sb(&buf, "        cur = self._conn.cursor()\n")
	_rs_sb(&buf, "        cur.execute(sql, params or ())\n")
	_rs_sb(&buf, "        if not self._in_tx:\n")
	_rs_sb(&buf, "            self._conn.commit()\n")
	_rs_sb(&buf, "        return cur.rowcount\n")
	_rs_sb(&buf, "\n")
	_rs_sb(&buf, "    def close(self):\n")
	_rs_sb(&buf, "        self._conn.close()\n")
	_rs_sb(&buf, "\n")
	_rs_sb(&buf, "    @property\n")
	_rs_sb(&buf, "    def in_transaction(self):\n")
	_rs_sb(&buf, "        return self._in_tx\n")
	_rs_sb(&buf, "\n")

	// Transaction class
	_rs_sb(&buf, "class _DB_Transaction:\n")
	_rs_sb(&buf, "    def __init__(self, conn):\n")
	_rs_sb(&buf, "        self._conn = conn\n")
	_rs_sb(&buf, "        self._conn._in_tx = True\n")
	_rs_sb(&buf, "        if self._conn._scheme == 'sqlite':\n")
	_rs_sb(&buf, "            self._conn._conn.execute('BEGIN')\n")
	_rs_sb(&buf, "        else:\n")
	_rs_sb(&buf, "            self._conn._conn.autocommit = False\n")
	_rs_sb(&buf, "\n")
	_rs_sb(&buf, "    def commit(self):\n")
	_rs_sb(&buf, "        self._conn._conn.commit()\n")
	_rs_sb(&buf, "        self._conn._in_tx = False\n")
	_rs_sb(&buf, "        if self._conn._scheme != 'sqlite':\n")
	_rs_sb(&buf, "            self._conn._conn.autocommit = True\n")
	_rs_sb(&buf, "\n")
	_rs_sb(&buf, "    def rollback(self):\n")
	_rs_sb(&buf, "        self._conn._conn.rollback()\n")
	_rs_sb(&buf, "        self._conn._in_tx = False\n")
	_rs_sb(&buf, "        if self._conn._scheme != 'sqlite':\n")
	_rs_sb(&buf, "            self._conn._conn.autocommit = True\n")
	_rs_sb(&buf, "\n")
	_rs_sb(&buf, "    def __enter__(self):\n")
	_rs_sb(&buf, "        return self\n")
	_rs_sb(&buf, "\n")
	_rs_sb(&buf, "    def __exit__(self, exc_type, exc_val, exc_tb):\n")
	_rs_sb(&buf, "        if exc_type is not None:\n")
	_rs_sb(&buf, "            self.rollback()\n")
	_rs_sb(&buf, "        else:\n")
	_rs_sb(&buf, "            self.commit()\n")
	_rs_sb(&buf, "        return False\n")
	_rs_sb(&buf, "\n")

	// connect function
	_rs_sb(&buf, "def _db_connect(url):\n")
	_rs_sb(&buf, "    parsed = urlparse(url)\n")
	_rs_sb(&buf, "    scheme = parsed.scheme.lower()\n")
	_rs_sb(&buf, "    if scheme == 'sqlite':\n")
	_rs_sb(&buf, "        db_path = parsed.path\n")
	_rs_sb(&buf, "        if db_path.startswith('/'):\n")
	_rs_sb(&buf, "            db_path = db_path[1:]\n")
	_rs_sb(&buf, "        if not db_path or db_path == ':memory:':\n")
	_rs_sb(&buf, "            db_path = ':memory:'\n")
	_rs_sb(&buf, "        conn = sqlite3.connect(db_path)\n")
	_rs_sb(&buf, "        conn.isolation_level = None  # autocommit by default\n")
	_rs_sb(&buf, "        return _DB_Connection(conn, 'sqlite')\n")
	_rs_sb(&buf, "    elif scheme in ('postgresql', 'postgres'):\n")
	_rs_sb(&buf, "        try:\n")
	_rs_sb(&buf, "            import psycopg2\n")
	_rs_sb(&buf, "        except ImportError:\n")
	_rs_sb(&buf, "            raise ImportError(\n")
	_rs_sb(&buf, "                'mimir.db: PostgreSQL requires psycopg2. '\n")
	_rs_sb(&buf, "                'Install: pip install psycopg2-binary'\n")
	_rs_sb(&buf, "            )\n")
	_rs_sb(&buf, "        conn = psycopg2.connect(url)\n")
	_rs_sb(&buf, "        conn.autocommit = True\n")
	_rs_sb(&buf, "        return _DB_Connection(conn, 'postgresql')\n")
	_rs_sb(&buf, "    elif scheme == 'mysql':\n")
	_rs_sb(&buf, "        try:\n")
	_rs_sb(&buf, "            import mysql.connector\n")
	_rs_sb(&buf, "        except ImportError:\n")
	_rs_sb(&buf, "            raise ImportError(\n")
	_rs_sb(&buf, "                'mimir.db: MySQL requires mysql-connector-python. '\n")
	_rs_sb(&buf, "                'Install: pip install mysql-connector-python'\n")
	_rs_sb(&buf, "            )\n")
	_rs_sb(&buf, "        conn = mysql.connector.connect(\n")
	_rs_sb(&buf, "            host=parsed.hostname or 'localhost',\n")
	_rs_sb(&buf, "            port=parsed.port or 3306,\n")
	_rs_sb(&buf, "            user=parsed.username or '',\n")
	_rs_sb(&buf, "            password=parsed.password or '',\n")
	_rs_sb(&buf, "            database=parsed.path.lstrip('/'),\n")
	_rs_sb(&buf, "            autocommit=True,\n")
	_rs_sb(&buf, "        )\n")
	_rs_sb(&buf, "        return _DB_Connection(conn, 'mysql')\n")
	_rs_sb(&buf, "    else:\n")
	_rs_sb(&buf, "        raise ValueError(f'mimir.db: unsupported database scheme: {scheme}')\n")
	_rs_sb(&buf, "\n")

	// Free functions
	_rs_sb(&buf, "def _db_query(conn, sql, params=None, result=None):\n")
	_rs_sb(&buf, "    return conn.query(sql, params, result)\n")
	_rs_sb(&buf, "\n")
	_rs_sb(&buf, "def _db_execute(conn, sql, params=None):\n")
	_rs_sb(&buf, "    return conn.execute(sql, params)\n")
	_rs_sb(&buf, "\n")
	_rs_sb(&buf, "def _db_transaction(conn):\n")
	_rs_sb(&buf, "    return _DB_Transaction(conn)\n")
	_rs_sb(&buf, "\n")

	// Module wiring
	_rs_sb(&buf, "# Wire mimir.db module\n")
	_rs_sb(&buf, "_db_mod = ModuleType('mimir.db')\n")
	_rs_sb(&buf, "_db_mod.Connection = _DB_Connection\n")
	_rs_sb(&buf, "_db_mod.Transaction = _DB_Transaction\n")
	_rs_sb(&buf, "_db_mod.connect = _db_connect\n")
	_rs_sb(&buf, "_db_mod.query = _db_query\n")
	_rs_sb(&buf, "_db_mod.execute = _db_execute\n")
	_rs_sb(&buf, "_db_mod.transaction = _db_transaction\n")
	_rs_sb(&buf, "sys.modules['mimir.db'] = _db_mod\n")
	_rs_sb(&buf, "\n")

	return string(buf[:])
}

// ==================== mimir.crypt shim ====================

generate_crypt_shim :: proc(allocator: mem.Allocator) -> string {
	buf := make([dynamic]u8, 0, 4096, allocator)

	_rs_sb(&buf, "# ---- mimir.crypt runtime shim ----\n")
	_rs_sb(&buf, "import hashlib, hmac, secrets\n")
	_rs_sb(&buf, "\n")

	// Hash namespace
	_rs_sb(&buf, "class _HashNS:\n")
	_rs_sb(&buf, "    def sha256(self, data): return hashlib.sha256(data).hexdigest()\n")
	_rs_sb(&buf, "    def sha512(self, data): return hashlib.sha512(data).hexdigest()\n")
	_rs_sb(&buf, "    def sha3_256(self, data): return hashlib.sha3_256(data).hexdigest()\n")
	_rs_sb(&buf, "    def sha1(self, data): return hashlib.sha1(data).hexdigest()\n")
	_rs_sb(&buf, "    def md5(self, data): return hashlib.md5(data).hexdigest()\n")
	_rs_sb(&buf, "    def bcrypt(self, password):\n")
	_rs_sb(&buf, "        try:\n")
	_rs_sb(&buf, "            import bcrypt as _bcrypt\n")
	_rs_sb(&buf, "        except ImportError:\n")
	_rs_sb(&buf, "            raise ImportError(\n")
	_rs_sb(&buf, "                'mimir.crypt: bcrypt requires the bcrypt package. '\n")
	_rs_sb(&buf, "                'Install: pip install bcrypt'\n")
	_rs_sb(&buf, "            )\n")
	_rs_sb(&buf, "        pwd = password.encode('utf-8') if isinstance(password, str) else password\n")
	_rs_sb(&buf, "        return _bcrypt.hashpw(pwd, _bcrypt.gensalt()).decode('utf-8')\n")
	_rs_sb(&buf, "    def argon2(self, password):\n")
	_rs_sb(&buf, "        try:\n")
	_rs_sb(&buf, "            from argon2 import PasswordHasher\n")
	_rs_sb(&buf, "        except ImportError:\n")
	_rs_sb(&buf, "            raise ImportError(\n")
	_rs_sb(&buf, "                'mimir.crypt: argon2 requires the argon2-cffi package. '\n")
	_rs_sb(&buf, "                'Install: pip install argon2-cffi'\n")
	_rs_sb(&buf, "            )\n")
	_rs_sb(&buf, "        return PasswordHasher().hash(password)\n")
	_rs_sb(&buf, "\n")

	// Verify namespace
	_rs_sb(&buf, "class _VerifyNS:\n")
	_rs_sb(&buf, "    def bcrypt(self, password, hashed):\n")
	_rs_sb(&buf, "        try:\n")
	_rs_sb(&buf, "            import bcrypt as _bcrypt\n")
	_rs_sb(&buf, "        except ImportError:\n")
	_rs_sb(&buf, "            raise ImportError(\n")
	_rs_sb(&buf, "                'mimir.crypt: bcrypt requires the bcrypt package. '\n")
	_rs_sb(&buf, "                'Install: pip install bcrypt'\n")
	_rs_sb(&buf, "            )\n")
	_rs_sb(&buf, "        pwd = password.encode('utf-8') if isinstance(password, str) else password\n")
	_rs_sb(&buf, "        h = hashed.encode('utf-8') if isinstance(hashed, str) else hashed\n")
	_rs_sb(&buf, "        return _bcrypt.checkpw(pwd, h)\n")
	_rs_sb(&buf, "    def argon2(self, password, hashed):\n")
	_rs_sb(&buf, "        try:\n")
	_rs_sb(&buf, "            from argon2 import PasswordHasher\n")
	_rs_sb(&buf, "        except ImportError:\n")
	_rs_sb(&buf, "            raise ImportError(\n")
	_rs_sb(&buf, "                'mimir.crypt: argon2 requires the argon2-cffi package. '\n")
	_rs_sb(&buf, "                'Install: pip install argon2-cffi'\n")
	_rs_sb(&buf, "            )\n")
	_rs_sb(&buf, "        try:\n")
	_rs_sb(&buf, "            return PasswordHasher().verify(hashed, password)\n")
	_rs_sb(&buf, "        except Exception:\n")
	_rs_sb(&buf, "            return False\n")
	_rs_sb(&buf, "\n")

	// Encrypt namespace
	_rs_sb(&buf, "class _EncryptNS:\n")
	_rs_sb(&buf, "    def _get_crypto(self):\n")
	_rs_sb(&buf, "        try:\n")
	_rs_sb(&buf, "            from cryptography.hazmat.primitives.ciphers.aead import AESGCM, ChaCha20Poly1305\n")
	_rs_sb(&buf, "            from cryptography.hazmat.primitives.ciphers import Cipher, algorithms, modes\n")
	_rs_sb(&buf, "            from cryptography.hazmat.primitives import padding\n")
	_rs_sb(&buf, "            return {'AESGCM': AESGCM, 'ChaCha20Poly1305': ChaCha20Poly1305,\n")
	_rs_sb(&buf, "                    'Cipher': Cipher, 'algorithms': algorithms, 'modes': modes,\n")
	_rs_sb(&buf, "                    'padding': padding}\n")
	_rs_sb(&buf, "        except ImportError:\n")
	_rs_sb(&buf, "            raise ImportError(\n")
	_rs_sb(&buf, "                'mimir.crypt: encryption requires the cryptography package. '\n")
	_rs_sb(&buf, "                'Install: pip install cryptography'\n")
	_rs_sb(&buf, "            )\n")
	_rs_sb(&buf, "    def aes_gcm(self, key, plaintext):\n")
	_rs_sb(&buf, "        c = self._get_crypto()\n")
	_rs_sb(&buf, "        nonce = secrets.token_bytes(12)\n")
	_rs_sb(&buf, "        ct = c['AESGCM'](key).encrypt(nonce, plaintext, None)\n")
	_rs_sb(&buf, "        return nonce + ct\n")
	_rs_sb(&buf, "    def aes_cbc(self, key, plaintext):\n")
	_rs_sb(&buf, "        c = self._get_crypto()\n")
	_rs_sb(&buf, "        iv = secrets.token_bytes(16)\n")
	_rs_sb(&buf, "        padder = c['padding'].PKCS7(128).padder()\n")
	_rs_sb(&buf, "        padded = padder.update(plaintext) + padder.finalize()\n")
	_rs_sb(&buf, "        cipher = c['Cipher'](c['algorithms'].AES(key), c['modes'].CBC(iv))\n")
	_rs_sb(&buf, "        enc = cipher.encryptor()\n")
	_rs_sb(&buf, "        return iv + enc.update(padded) + enc.finalize()\n")
	_rs_sb(&buf, "    def aes_ctr(self, key, plaintext):\n")
	_rs_sb(&buf, "        c = self._get_crypto()\n")
	_rs_sb(&buf, "        nonce = secrets.token_bytes(16)\n")
	_rs_sb(&buf, "        cipher = c['Cipher'](c['algorithms'].AES(key), c['modes'].CTR(nonce))\n")
	_rs_sb(&buf, "        enc = cipher.encryptor()\n")
	_rs_sb(&buf, "        return nonce + enc.update(plaintext) + enc.finalize()\n")
	_rs_sb(&buf, "    def aes_ecb(self, key, plaintext):\n")
	_rs_sb(&buf, "        c = self._get_crypto()\n")
	_rs_sb(&buf, "        padder = c['padding'].PKCS7(128).padder()\n")
	_rs_sb(&buf, "        padded = padder.update(plaintext) + padder.finalize()\n")
	_rs_sb(&buf, "        cipher = c['Cipher'](c['algorithms'].AES(key), c['modes'].ECB())\n")
	_rs_sb(&buf, "        enc = cipher.encryptor()\n")
	_rs_sb(&buf, "        return enc.update(padded) + enc.finalize()\n")
	_rs_sb(&buf, "    def chacha20(self, key, plaintext):\n")
	_rs_sb(&buf, "        c = self._get_crypto()\n")
	_rs_sb(&buf, "        nonce = secrets.token_bytes(12)\n")
	_rs_sb(&buf, "        ct = c['ChaCha20Poly1305'](key).encrypt(nonce, plaintext, None)\n")
	_rs_sb(&buf, "        return nonce + ct\n")
	_rs_sb(&buf, "\n")

	// Decrypt namespace
	_rs_sb(&buf, "class _DecryptNS:\n")
	_rs_sb(&buf, "    def _get_crypto(self):\n")
	_rs_sb(&buf, "        try:\n")
	_rs_sb(&buf, "            from cryptography.hazmat.primitives.ciphers.aead import AESGCM, ChaCha20Poly1305\n")
	_rs_sb(&buf, "            from cryptography.hazmat.primitives.ciphers import Cipher, algorithms, modes\n")
	_rs_sb(&buf, "            from cryptography.hazmat.primitives import padding\n")
	_rs_sb(&buf, "            return {'AESGCM': AESGCM, 'ChaCha20Poly1305': ChaCha20Poly1305,\n")
	_rs_sb(&buf, "                    'Cipher': Cipher, 'algorithms': algorithms, 'modes': modes,\n")
	_rs_sb(&buf, "                    'padding': padding}\n")
	_rs_sb(&buf, "        except ImportError:\n")
	_rs_sb(&buf, "            raise ImportError(\n")
	_rs_sb(&buf, "                'mimir.crypt: decryption requires the cryptography package. '\n")
	_rs_sb(&buf, "                'Install: pip install cryptography'\n")
	_rs_sb(&buf, "            )\n")
	_rs_sb(&buf, "    def aes_gcm(self, key, ciphertext):\n")
	_rs_sb(&buf, "        c = self._get_crypto()\n")
	_rs_sb(&buf, "        nonce, ct = ciphertext[:12], ciphertext[12:]\n")
	_rs_sb(&buf, "        return c['AESGCM'](key).decrypt(nonce, ct, None)\n")
	_rs_sb(&buf, "    def aes_cbc(self, key, ciphertext):\n")
	_rs_sb(&buf, "        c = self._get_crypto()\n")
	_rs_sb(&buf, "        iv, ct = ciphertext[:16], ciphertext[16:]\n")
	_rs_sb(&buf, "        cipher = c['Cipher'](c['algorithms'].AES(key), c['modes'].CBC(iv))\n")
	_rs_sb(&buf, "        dec = cipher.decryptor()\n")
	_rs_sb(&buf, "        padded = dec.update(ct) + dec.finalize()\n")
	_rs_sb(&buf, "        unpadder = c['padding'].PKCS7(128).unpadder()\n")
	_rs_sb(&buf, "        return unpadder.update(padded) + unpadder.finalize()\n")
	_rs_sb(&buf, "    def aes_ctr(self, key, ciphertext):\n")
	_rs_sb(&buf, "        c = self._get_crypto()\n")
	_rs_sb(&buf, "        nonce, ct = ciphertext[:16], ciphertext[16:]\n")
	_rs_sb(&buf, "        cipher = c['Cipher'](c['algorithms'].AES(key), c['modes'].CTR(nonce))\n")
	_rs_sb(&buf, "        dec = cipher.decryptor()\n")
	_rs_sb(&buf, "        return dec.update(ct) + dec.finalize()\n")
	_rs_sb(&buf, "    def aes_ecb(self, key, ciphertext):\n")
	_rs_sb(&buf, "        c = self._get_crypto()\n")
	_rs_sb(&buf, "        cipher = c['Cipher'](c['algorithms'].AES(key), c['modes'].ECB())\n")
	_rs_sb(&buf, "        dec = cipher.decryptor()\n")
	_rs_sb(&buf, "        padded = dec.update(ciphertext) + dec.finalize()\n")
	_rs_sb(&buf, "        unpadder = c['padding'].PKCS7(128).unpadder()\n")
	_rs_sb(&buf, "        return unpadder.update(padded) + unpadder.finalize()\n")
	_rs_sb(&buf, "    def chacha20(self, key, ciphertext):\n")
	_rs_sb(&buf, "        c = self._get_crypto()\n")
	_rs_sb(&buf, "        nonce, ct = ciphertext[:12], ciphertext[12:]\n")
	_rs_sb(&buf, "        return c['ChaCha20Poly1305'](key).decrypt(nonce, ct, None)\n")
	_rs_sb(&buf, "\n")

	// Token namespace
	_rs_sb(&buf, "class _TokenNS:\n")
	_rs_sb(&buf, "    def bytes(self, n): return secrets.token_bytes(n)\n")
	_rs_sb(&buf, "    def urlsafe(self, n): return secrets.token_urlsafe(n)\n")
	_rs_sb(&buf, "    def digits(self, n): return ''.join(secrets.choice('0123456789') for _ in range(n))\n")
	_rs_sb(&buf, "    def hex(self, n): return secrets.token_hex(n)\n")
	_rs_sb(&buf, "\n")

	// Sign namespace
	_rs_sb(&buf, "class _SignNS:\n")
	_rs_sb(&buf, "    def hmac_sha256(self, key, message): return hmac.new(key, message, 'sha256').digest()\n")
	_rs_sb(&buf, "    def hmac_sha512(self, key, message): return hmac.new(key, message, 'sha512').digest()\n")
	_rs_sb(&buf, "    def ed25519(self, key, message):\n")
	_rs_sb(&buf, "        try:\n")
	_rs_sb(&buf, "            from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey\n")
	_rs_sb(&buf, "        except ImportError:\n")
	_rs_sb(&buf, "            raise ImportError(\n")
	_rs_sb(&buf, "                'mimir.crypt: Ed25519 requires the cryptography package. '\n")
	_rs_sb(&buf, "                'Install: pip install cryptography'\n")
	_rs_sb(&buf, "            )\n")
	_rs_sb(&buf, "        pk = Ed25519PrivateKey.from_private_bytes(key)\n")
	_rs_sb(&buf, "        return pk.sign(message)\n")
	_rs_sb(&buf, "\n")

	// Module wiring
	_rs_sb(&buf, "# Wire mimir.crypt module\n")
	_rs_sb(&buf, "_crypt_mod = ModuleType('mimir.crypt')\n")
	_rs_sb(&buf, "_crypt_mod.hash = _HashNS()\n")
	_rs_sb(&buf, "_crypt_mod.verify = _VerifyNS()\n")
	_rs_sb(&buf, "_crypt_mod.encrypt = _EncryptNS()\n")
	_rs_sb(&buf, "_crypt_mod.decrypt = _DecryptNS()\n")
	_rs_sb(&buf, "_crypt_mod.token = _TokenNS()\n")
	_rs_sb(&buf, "_crypt_mod.sign = _SignNS()\n")
	_rs_sb(&buf, "sys.modules['mimir.crypt'] = _crypt_mod\n")
	_rs_sb(&buf, "\n")

	return string(buf[:])
}

// ==================== mimir.json shim ====================

generate_json_shim :: proc(allocator: mem.Allocator) -> string {
	buf := make([dynamic]u8, 0, 1024, allocator)

	_rs_sb(&buf, "# ---- mimir.json runtime shim ----\n")
	_rs_sb(&buf, "import json as _json_stdlib\n")
	_rs_sb(&buf, "\n")
	_rs_sb(&buf, "def _json_parse(data, schema=None): return _json_stdlib.loads(data)\n")
	_rs_sb(&buf, "def _json_read(path, schema=None):\n")
	_rs_sb(&buf, "    with open(path, 'r') as f: return _json_stdlib.load(f)\n")
	_rs_sb(&buf, "def _json_serialize(obj): return _json_stdlib.dumps(obj)\n")
	_rs_sb(&buf, "def _json_write(obj, path):\n")
	_rs_sb(&buf, "    with open(path, 'w') as f: _json_stdlib.dump(obj, f)\n")
	_rs_sb(&buf, "def _json_load(path):\n")
	_rs_sb(&buf, "    with open(path, 'r') as f: return _json_stdlib.load(f)\n")
	_rs_sb(&buf, "def _json_loads(data): return _json_stdlib.loads(data)\n")
	_rs_sb(&buf, "def _json_dump(obj, path):\n")
	_rs_sb(&buf, "    with open(path, 'w') as f: _json_stdlib.dump(obj, f)\n")
	_rs_sb(&buf, "def _json_dumps(obj): return _json_stdlib.dumps(obj)\n")
	_rs_sb(&buf, "\n")

	// Module wiring
	_rs_sb(&buf, "# Wire mimir.json module\n")
	_rs_sb(&buf, "_json_mod = ModuleType('mimir.json')\n")
	_rs_sb(&buf, "_json_mod.parse = _json_parse\n")
	_rs_sb(&buf, "_json_mod.read = _json_read\n")
	_rs_sb(&buf, "_json_mod.serialize = _json_serialize\n")
	_rs_sb(&buf, "_json_mod.write = _json_write\n")
	_rs_sb(&buf, "_json_mod.load = _json_load\n")
	_rs_sb(&buf, "_json_mod.loads = _json_loads\n")
	_rs_sb(&buf, "_json_mod.dump = _json_dump\n")
	_rs_sb(&buf, "_json_mod.dumps = _json_dumps\n")
	_rs_sb(&buf, "sys.modules['mimir.json'] = _json_mod\n")
	_rs_sb(&buf, "\n")

	return string(buf[:])
}

// ==================== mimir.data shim ====================

generate_data_shim :: proc(allocator: mem.Allocator) -> string {
	buf := make([dynamic]u8, 0, 8192, allocator)

	_rs_sb(&buf, "# ---- mimir.data runtime shim ----\n")
	_rs_sb(&buf, "import csv as _csv_stdlib, math as _math_stdlib\n")
	_rs_sb(&buf, "\n")

	// Series class
	_rs_sb(&buf, "class _Data_Series:\n")
	_rs_sb(&buf, "    def __init__(self, data=None, name=''):\n")
	_rs_sb(&buf, "        self._data = list(data) if data is not None else []\n")
	_rs_sb(&buf, "        self._name = name\n")
	_rs_sb(&buf, "\n")
	_rs_sb(&buf, "    @property\n")
	_rs_sb(&buf, "    def name(self): return self._name\n")
	_rs_sb(&buf, "    @property\n")
	_rs_sb(&buf, "    def values(self): return list(self._data)\n")
	_rs_sb(&buf, "    @property\n")
	_rs_sb(&buf, "    def dtype(self):\n")
	_rs_sb(&buf, "        for v in self._data:\n")
	_rs_sb(&buf, "            if v is not None:\n")
	_rs_sb(&buf, "                return type(v).__name__\n")
	_rs_sb(&buf, "        return 'object'\n")
	_rs_sb(&buf, "    @property\n")
	_rs_sb(&buf, "    def shape(self): return (len(self._data),)\n")
	_rs_sb(&buf, "\n")
	_rs_sb(&buf, "    def _numerics(self):\n")
	_rs_sb(&buf, "        return [v for v in self._data if isinstance(v, (int, float)) and not isinstance(v, bool)]\n")
	_rs_sb(&buf, "\n")
	_rs_sb(&buf, "    def mean(self):\n")
	_rs_sb(&buf, "        ns = self._numerics()\n")
	_rs_sb(&buf, "        return sum(ns) / len(ns) if ns else float('nan')\n")
	_rs_sb(&buf, "    def sum(self):\n")
	_rs_sb(&buf, "        ns = self._numerics()\n")
	_rs_sb(&buf, "        return sum(ns)\n")
	_rs_sb(&buf, "    def min(self):\n")
	_rs_sb(&buf, "        ns = self._numerics()\n")
	_rs_sb(&buf, "        return min(ns) if ns else float('nan')\n")
	_rs_sb(&buf, "    def max(self):\n")
	_rs_sb(&buf, "        ns = self._numerics()\n")
	_rs_sb(&buf, "        return max(ns) if ns else float('nan')\n")
	_rs_sb(&buf, "    def std(self):\n")
	_rs_sb(&buf, "        ns = self._numerics()\n")
	_rs_sb(&buf, "        if len(ns) < 2: return float('nan')\n")
	_rs_sb(&buf, "        m = sum(ns) / len(ns)\n")
	_rs_sb(&buf, "        return _math_stdlib.sqrt(sum((x - m) ** 2 for x in ns) / (len(ns) - 1))\n")
	_rs_sb(&buf, "    def count(self): return len([v for v in self._data if v is not None])\n")
	_rs_sb(&buf, "\n")
	_rs_sb(&buf, "    def sort_values(self, ascending=True):\n")
	_rs_sb(&buf, "        def _sort_key(v):\n")
	_rs_sb(&buf, "            if v is None: return (2, '', 0)\n")
	_rs_sb(&buf, "            if isinstance(v, bool): return (0, 'bool', int(v))\n")
	_rs_sb(&buf, "            if isinstance(v, (int, float)): return (0, 'num', v)\n")
	_rs_sb(&buf, "            return (1, type(v).__name__, str(v))\n")
	_rs_sb(&buf, "        return _Data_Series(sorted(self._data, key=_sort_key, reverse=not ascending), self._name)\n")
	_rs_sb(&buf, "    def fillna(self, value):\n")
	_rs_sb(&buf, "        return _Data_Series([value if v is None else v for v in self._data], self._name)\n")
	_rs_sb(&buf, "    def dropna(self):\n")
	_rs_sb(&buf, "        return _Data_Series([v for v in self._data if v is not None], self._name)\n")
	_rs_sb(&buf, "    def unique(self):\n")
	_rs_sb(&buf, "        seen = set(); result = []\n")
	_rs_sb(&buf, "        for v in self._data:\n")
	_rs_sb(&buf, "            if v not in seen: seen.add(v); result.append(v)\n")
	_rs_sb(&buf, "        return result\n")
	_rs_sb(&buf, "    def head(self, n=5): return _Data_Series(self._data[:n], self._name)\n")
	_rs_sb(&buf, "    def tail(self, n=5): return _Data_Series(self._data[-n:], self._name)\n")
	_rs_sb(&buf, "\n")
	_rs_sb(&buf, "    def __len__(self): return len(self._data)\n")
	_rs_sb(&buf, "    def __iter__(self): return iter(self._data)\n")
	_rs_sb(&buf, "    def __getitem__(self, key):\n")
	_rs_sb(&buf, "        if isinstance(key, slice): return _Data_Series(self._data[key], self._name)\n")
	_rs_sb(&buf, "        return self._data[key]\n")
	_rs_sb(&buf, "    def __repr__(self):\n")
	_rs_sb(&buf, "        return f'Series(name={self._name!r}, len={len(self._data)})'\n")
	_rs_sb(&buf, "\n")

	// DataFrame class
	_rs_sb(&buf, "class _Data_DataFrame:\n")
	_rs_sb(&buf, "    def __init__(self, data=None):\n")
	_rs_sb(&buf, "        if data is None:\n")
	_rs_sb(&buf, "            self._cols = {}; self._nrows = 0; return\n")
	_rs_sb(&buf, "        if isinstance(data, dict):\n")
	_rs_sb(&buf, "            self._cols = {k: list(v) for k, v in data.items()}\n")
	_rs_sb(&buf, "            self._nrows = max((len(v) for v in self._cols.values()), default=0)\n")
	_rs_sb(&buf, "        elif isinstance(data, list):\n")
	_rs_sb(&buf, "            if data and isinstance(data[0], dict):\n")
	_rs_sb(&buf, "                keys = list(data[0].keys())\n")
	_rs_sb(&buf, "                self._cols = {k: [row.get(k) for row in data] for k in keys}\n")
	_rs_sb(&buf, "                self._nrows = len(data)\n")
	_rs_sb(&buf, "            else:\n")
	_rs_sb(&buf, "                self._cols = {'0': list(data)}; self._nrows = len(data)\n")
	_rs_sb(&buf, "        else:\n")
	_rs_sb(&buf, "            self._cols = {}; self._nrows = 0\n")
	_rs_sb(&buf, "\n")

	// Properties
	_rs_sb(&buf, "    @property\n")
	_rs_sb(&buf, "    def shape(self): return (self._nrows, len(self._cols))\n")
	_rs_sb(&buf, "    @property\n")
	_rs_sb(&buf, "    def columns(self): return list(self._cols.keys())\n")
	_rs_sb(&buf, "    @property\n")
	_rs_sb(&buf, "    def dtypes(self):\n")
	_rs_sb(&buf, "        result = {}\n")
	_rs_sb(&buf, "        for k, v in self._cols.items():\n")
	_rs_sb(&buf, "            for val in v:\n")
	_rs_sb(&buf, "                if val is not None: result[k] = type(val).__name__; break\n")
	_rs_sb(&buf, "            else: result[k] = 'object'\n")
	_rs_sb(&buf, "        return result\n")
	_rs_sb(&buf, "    @property\n")
	_rs_sb(&buf, "    def values(self):\n")
	_rs_sb(&buf, "        keys = list(self._cols.keys())\n")
	_rs_sb(&buf, "        return [[self._cols[k][i] for k in keys] for i in range(self._nrows)]\n")
	_rs_sb(&buf, "    @property\n")
	_rs_sb(&buf, "    def index(self): return list(range(self._nrows))\n")
	_rs_sb(&buf, "    @property\n")
	_rs_sb(&buf, "    def T(self):\n")
	_rs_sb(&buf, "        keys = list(self._cols.keys())\n")
	_rs_sb(&buf, "        data = {str(i): [self._cols[k][i] for k in keys] for i in range(self._nrows)}\n")
	_rs_sb(&buf, "        return _Data_DataFrame(data)\n")
	_rs_sb(&buf, "\n")

	// Subscript
	_rs_sb(&buf, "    def __getitem__(self, key):\n")
	_rs_sb(&buf, "        if isinstance(key, str):\n")
	_rs_sb(&buf, "            if key not in self._cols: raise KeyError(f'Column {key!r} not found')\n")
	_rs_sb(&buf, "            return _Data_Series(self._cols[key], key)\n")
	_rs_sb(&buf, "        if isinstance(key, list):\n")
	_rs_sb(&buf, "            return _Data_DataFrame({k: list(self._cols[k]) for k in key if k in self._cols})\n")
	_rs_sb(&buf, "        if isinstance(key, slice):\n")
	_rs_sb(&buf, "            return _Data_DataFrame({k: v[key] for k, v in self._cols.items()})\n")
	_rs_sb(&buf, "        raise TypeError(f'Invalid key type: {type(key).__name__}')\n")
	_rs_sb(&buf, "\n")
	_rs_sb(&buf, "    def __setitem__(self, key, value):\n")
	_rs_sb(&buf, "        if isinstance(key, str):\n")
	_rs_sb(&buf, "            if isinstance(value, _Data_Series): value = value._data\n")
	_rs_sb(&buf, "            if isinstance(value, (list, tuple)):\n")
	_rs_sb(&buf, "                self._cols[key] = list(value)\n")
	_rs_sb(&buf, "            else:\n")
	_rs_sb(&buf, "                self._cols[key] = [value] * self._nrows\n")
	_rs_sb(&buf, "            self._nrows = max(self._nrows, len(self._cols[key]))\n")
	_rs_sb(&buf, "\n")
	_rs_sb(&buf, "    def __len__(self): return self._nrows\n")
	_rs_sb(&buf, "    def __repr__(self):\n")
	_rs_sb(&buf, "        return f'DataFrame(shape={self.shape}, columns={self.columns})'\n")
	_rs_sb(&buf, "\n")

	// DataFrame methods — column-preserving transforms
	_rs_sb(&buf, "    def _from_cols(self, cols, nrows=None):\n")
	_rs_sb(&buf, "        df = _Data_DataFrame()\n")
	_rs_sb(&buf, "        df._cols = cols\n")
	_rs_sb(&buf, "        df._nrows = nrows if nrows is not None else max((len(v) for v in cols.values()), default=0)\n")
	_rs_sb(&buf, "        return df\n")
	_rs_sb(&buf, "\n")
	_rs_sb(&buf, "    def sort_values(self, by, ascending=True):\n")
	_rs_sb(&buf, "        if by not in self._cols: return self.copy()\n")
	_rs_sb(&buf, "        def _sort_key(i):\n")
	_rs_sb(&buf, "            v = self._cols[by][i]\n")
	_rs_sb(&buf, "            if v is None: return (2, '', 0)\n")
	_rs_sb(&buf, "            if isinstance(v, bool): return (0, 'bool', int(v))\n")
	_rs_sb(&buf, "            if isinstance(v, (int, float)): return (0, 'num', v)\n")
	_rs_sb(&buf, "            return (1, type(v).__name__, str(v))\n")
	_rs_sb(&buf, "        idx = sorted(range(self._nrows), key=_sort_key, reverse=not ascending)\n")
	_rs_sb(&buf, "        return self._from_cols({k: [v[i] for i in idx] for k, v in self._cols.items()}, len(idx))\n")
	_rs_sb(&buf, "\n")
	_rs_sb(&buf, "    def head(self, n=5):\n")
	_rs_sb(&buf, "        n = min(n, self._nrows)\n")
	_rs_sb(&buf, "        return self._from_cols({k: v[:n] for k, v in self._cols.items()}, n)\n")
	_rs_sb(&buf, "    def tail(self, n=5):\n")
	_rs_sb(&buf, "        n = min(n, self._nrows)\n")
	_rs_sb(&buf, "        return self._from_cols({k: v[-n:] for k, v in self._cols.items()}, n)\n")
	_rs_sb(&buf, "\n")
	_rs_sb(&buf, "    def drop_duplicates(self):\n")
	_rs_sb(&buf, "        keys = list(self._cols.keys())\n")
	_rs_sb(&buf, "        seen = set(); idx = []\n")
	_rs_sb(&buf, "        for i in range(self._nrows):\n")
	_rs_sb(&buf, "            row = tuple(self._cols[k][i] for k in keys)\n")
	_rs_sb(&buf, "            if row not in seen: seen.add(row); idx.append(i)\n")
	_rs_sb(&buf, "        return self._from_cols({k: [v[i] for i in idx] for k, v in self._cols.items()}, len(idx))\n")
	_rs_sb(&buf, "\n")
	_rs_sb(&buf, "    def fillna(self, value):\n")
	_rs_sb(&buf, "        return self._from_cols({k: [value if v is None else v for v in col] for k, col in self._cols.items()}, self._nrows)\n")
	_rs_sb(&buf, "    def dropna(self):\n")
	_rs_sb(&buf, "        keys = list(self._cols.keys())\n")
	_rs_sb(&buf, "        idx = [i for i in range(self._nrows) if all(self._cols[k][i] is not None for k in keys)]\n")
	_rs_sb(&buf, "        return self._from_cols({k: [v[i] for i in idx] for k, v in self._cols.items()}, len(idx))\n")
	_rs_sb(&buf, "    def copy(self):\n")
	_rs_sb(&buf, "        return self._from_cols({k: list(v) for k, v in self._cols.items()}, self._nrows)\n")
	_rs_sb(&buf, "    def reset_index(self, drop=True):\n")
	_rs_sb(&buf, "        return self.copy()\n")
	_rs_sb(&buf, "    def rename(self, columns=None):\n")
	_rs_sb(&buf, "        if columns is None: return self.copy()\n")
	_rs_sb(&buf, "        new_cols = {columns.get(k, k): list(v) for k, v in self._cols.items()}\n")
	_rs_sb(&buf, "        return self._from_cols(new_cols, self._nrows)\n")
	_rs_sb(&buf, "\n")

	// Aggregation
	_rs_sb(&buf, "    def mean(self):\n")
	_rs_sb(&buf, "        result = {}\n")
	_rs_sb(&buf, "        for k, v in self._cols.items():\n")
	_rs_sb(&buf, "            ns = [x for x in v if isinstance(x, (int, float)) and not isinstance(x, bool)]\n")
	_rs_sb(&buf, "            if ns: result[k] = sum(ns) / len(ns)\n")
	_rs_sb(&buf, "        return _Data_Series(list(result.values()), '') if result else _Data_Series([])\n")
	_rs_sb(&buf, "    def sum(self):\n")
	_rs_sb(&buf, "        result = {}\n")
	_rs_sb(&buf, "        for k, v in self._cols.items():\n")
	_rs_sb(&buf, "            ns = [x for x in v if isinstance(x, (int, float)) and not isinstance(x, bool)]\n")
	_rs_sb(&buf, "            if ns: result[k] = sum(ns)\n")
	_rs_sb(&buf, "        return _Data_Series(list(result.values()), '') if result else _Data_Series([])\n")
	_rs_sb(&buf, "    def min(self):\n")
	_rs_sb(&buf, "        result = {}\n")
	_rs_sb(&buf, "        for k, v in self._cols.items():\n")
	_rs_sb(&buf, "            ns = [x for x in v if isinstance(x, (int, float)) and not isinstance(x, bool)]\n")
	_rs_sb(&buf, "            if ns: result[k] = min(ns)\n")
	_rs_sb(&buf, "        return _Data_Series(list(result.values()), '') if result else _Data_Series([])\n")
	_rs_sb(&buf, "    def max(self):\n")
	_rs_sb(&buf, "        result = {}\n")
	_rs_sb(&buf, "        for k, v in self._cols.items():\n")
	_rs_sb(&buf, "            ns = [x for x in v if isinstance(x, (int, float)) and not isinstance(x, bool)]\n")
	_rs_sb(&buf, "            if ns: result[k] = max(ns)\n")
	_rs_sb(&buf, "        return _Data_Series(list(result.values()), '') if result else _Data_Series([])\n")
	_rs_sb(&buf, "    def std(self):\n")
	_rs_sb(&buf, "        result = {}\n")
	_rs_sb(&buf, "        for k, v in self._cols.items():\n")
	_rs_sb(&buf, "            ns = [x for x in v if isinstance(x, (int, float)) and not isinstance(x, bool)]\n")
	_rs_sb(&buf, "            if len(ns) >= 2:\n")
	_rs_sb(&buf, "                m = sum(ns) / len(ns)\n")
	_rs_sb(&buf, "                result[k] = _math_stdlib.sqrt(sum((x - m) ** 2 for x in ns) / (len(ns) - 1))\n")
	_rs_sb(&buf, "        return _Data_Series(list(result.values()), '') if result else _Data_Series([])\n")
	_rs_sb(&buf, "    def count(self):\n")
	_rs_sb(&buf, "        result = {k: len([x for x in v if x is not None]) for k, v in self._cols.items()}\n")
	_rs_sb(&buf, "        return _Data_Series(list(result.values()), '')\n")
	_rs_sb(&buf, "\n")

	// GroupBy, merge, I/O
	_rs_sb(&buf, "    def groupby(self, by):\n")
	_rs_sb(&buf, "        return _Data_GroupBy(self, by)\n")
	_rs_sb(&buf, "    def merge(self, right, on=None, how='inner'):\n")
	_rs_sb(&buf, "        return _data_merge(self, right, on, how)\n")
	_rs_sb(&buf, "    def to_csv(self, path):\n")
	_rs_sb(&buf, "        keys = list(self._cols.keys())\n")
	_rs_sb(&buf, "        with open(path, 'w', newline='') as f:\n")
	_rs_sb(&buf, "            w = _csv_stdlib.writer(f)\n")
	_rs_sb(&buf, "            w.writerow(keys)\n")
	_rs_sb(&buf, "            for i in range(self._nrows):\n")
	_rs_sb(&buf, "                w.writerow([self._cols[k][i] for k in keys])\n")
	_rs_sb(&buf, "    def to_json(self, path):\n")
	_rs_sb(&buf, "        import json as _j\n")
	_rs_sb(&buf, "        rows = self.values\n")
	_rs_sb(&buf, "        keys = self.columns\n")
	_rs_sb(&buf, "        data = [dict(zip(keys, row)) for row in rows]\n")
	_rs_sb(&buf, "        with open(path, 'w') as f: _j.dump(data, f)\n")
	_rs_sb(&buf, "\n")

	// GroupBy
	_rs_sb(&buf, "class _Data_GroupBy:\n")
	_rs_sb(&buf, "    def __init__(self, df, by):\n")
	_rs_sb(&buf, "        self._df = df; self._by = by\n")
	_rs_sb(&buf, "        self._groups = {}\n")
	_rs_sb(&buf, "        if by in df._cols:\n")
	_rs_sb(&buf, "            for i in range(df._nrows):\n")
	_rs_sb(&buf, "                key = df._cols[by][i]\n")
	_rs_sb(&buf, "                self._groups.setdefault(key, []).append(i)\n")
	_rs_sb(&buf, "\n")
	_rs_sb(&buf, "    def _agg(self, fn):\n")
	_rs_sb(&buf, "        keys = [k for k in self._df._cols if k != self._by]\n")
	_rs_sb(&buf, "        result_cols = {self._by: [], **{k: [] for k in keys}}\n")
	_rs_sb(&buf, "        for gk, idx in self._groups.items():\n")
	_rs_sb(&buf, "            result_cols[self._by].append(gk)\n")
	_rs_sb(&buf, "            for k in keys:\n")
	_rs_sb(&buf, "                vals = [self._df._cols[k][i] for i in idx]\n")
	_rs_sb(&buf, "                ns = [v for v in vals if isinstance(v, (int, float)) and not isinstance(v, bool)]\n")
	_rs_sb(&buf, "                result_cols[k].append(fn(ns) if ns else None)\n")
	_rs_sb(&buf, "        df = _Data_DataFrame()\n")
	_rs_sb(&buf, "        df._cols = result_cols\n")
	_rs_sb(&buf, "        df._nrows = len(self._groups)\n")
	_rs_sb(&buf, "        return df\n")
	_rs_sb(&buf, "\n")
	_rs_sb(&buf, "    def mean(self): return self._agg(lambda ns: sum(ns) / len(ns))\n")
	_rs_sb(&buf, "    def sum(self): return self._agg(sum)\n")
	_rs_sb(&buf, "    def min(self): return self._agg(min)\n")
	_rs_sb(&buf, "    def max(self): return self._agg(max)\n")
	_rs_sb(&buf, "    def count(self): return self._agg(len)\n")
	_rs_sb(&buf, "\n")

	// Free functions
	_rs_sb(&buf, "def _data_read_csv(path, schema=None):\n")
	_rs_sb(&buf, "    with open(path, 'r', newline='') as f:\n")
	_rs_sb(&buf, "        reader = _csv_stdlib.DictReader(f)\n")
	_rs_sb(&buf, "        rows = list(reader)\n")
	_rs_sb(&buf, "    if not rows: return _Data_DataFrame()\n")
	_rs_sb(&buf, "    cols = {k: [] for k in rows[0].keys()}\n")
	_rs_sb(&buf, "    for row in rows:\n")
	_rs_sb(&buf, "        for k in cols:\n")
	_rs_sb(&buf, "            val = row.get(k, '')\n")
	_rs_sb(&buf, "            if val == '':\n")
	_rs_sb(&buf, "                cols[k].append(None)\n")
	_rs_sb(&buf, "                continue\n")
	_rs_sb(&buf, "            try: val = int(val)\n")
	_rs_sb(&buf, "            except (ValueError, TypeError):\n")
	_rs_sb(&buf, "                try: val = float(val)\n")
	_rs_sb(&buf, "                except (ValueError, TypeError): pass\n")
	_rs_sb(&buf, "            cols[k].append(val)\n")
	_rs_sb(&buf, "    df = _Data_DataFrame()\n")
	_rs_sb(&buf, "    df._cols = cols; df._nrows = len(rows)\n")
	_rs_sb(&buf, "    return df\n")
	_rs_sb(&buf, "\n")

	_rs_sb(&buf, "def _data_read_json(path, schema=None):\n")
	_rs_sb(&buf, "    import json as _j\n")
	_rs_sb(&buf, "    with open(path, 'r') as f: data = _j.load(f)\n")
	_rs_sb(&buf, "    if isinstance(data, list): return _Data_DataFrame(data)\n")
	_rs_sb(&buf, "    if isinstance(data, dict): return _Data_DataFrame(data)\n")
	_rs_sb(&buf, "    return _Data_DataFrame()\n")
	_rs_sb(&buf, "\n")

	_rs_sb(&buf, "def _data_read_parquet(path, schema=None):\n")
	_rs_sb(&buf, "    try:\n")
	_rs_sb(&buf, "        import pyarrow.parquet as pq\n")
	_rs_sb(&buf, "        table = pq.read_table(path)\n")
	_rs_sb(&buf, "        cols = {name: table.column(name).to_pylist() for name in table.column_names}\n")
	_rs_sb(&buf, "        df = _Data_DataFrame()\n")
	_rs_sb(&buf, "        df._cols = cols; df._nrows = table.num_rows\n")
	_rs_sb(&buf, "        return df\n")
	_rs_sb(&buf, "    except ImportError:\n")
	_rs_sb(&buf, "        raise ImportError(\n")
	_rs_sb(&buf, "            'mimir.data: Parquet support requires pyarrow. '\n")
	_rs_sb(&buf, "            'Install: pip install pyarrow'\n")
	_rs_sb(&buf, "        )\n")
	_rs_sb(&buf, "\n")

	_rs_sb(&buf, "def _data_merge(left, right, on=None, how='inner'):\n")
	_rs_sb(&buf, "    if how not in ('inner', 'left'):\n")
	_rs_sb(&buf, "        raise ValueError(f\"mimir.data: merge how='{how}' not supported. Use 'inner' or 'left'.\")\n")
	_rs_sb(&buf, "    if on is None:\n")
	_rs_sb(&buf, "        on = next((k for k in left._cols if k in right._cols), None)\n")
	_rs_sb(&buf, "    if on is None: return _Data_DataFrame()\n")
	_rs_sb(&buf, "    l_keys = list(left._cols.keys())\n")
	_rs_sb(&buf, "    r_keys = [k for k in right._cols.keys() if k != on]\n")
	_rs_sb(&buf, "    result_cols = {k: [] for k in l_keys + r_keys}\n")
	_rs_sb(&buf, "    r_index = {}\n")
	_rs_sb(&buf, "    for i in range(right._nrows):\n")
	_rs_sb(&buf, "        key = right._cols[on][i]\n")
	_rs_sb(&buf, "        r_index.setdefault(key, []).append(i)\n")
	_rs_sb(&buf, "    nrows = 0\n")
	_rs_sb(&buf, "    for i in range(left._nrows):\n")
	_rs_sb(&buf, "        key = left._cols[on][i]\n")
	_rs_sb(&buf, "        matches = r_index.get(key, [])\n")
	_rs_sb(&buf, "        if not matches and how == 'inner': continue\n")
	_rs_sb(&buf, "        if not matches: matches = [None]\n")
	_rs_sb(&buf, "        for j in matches:\n")
	_rs_sb(&buf, "            for k in l_keys: result_cols[k].append(left._cols[k][i])\n")
	_rs_sb(&buf, "            for k in r_keys:\n")
	_rs_sb(&buf, "                result_cols[k].append(right._cols[k][j] if j is not None else None)\n")
	_rs_sb(&buf, "            nrows += 1\n")
	_rs_sb(&buf, "    df = _Data_DataFrame()\n")
	_rs_sb(&buf, "    df._cols = result_cols; df._nrows = nrows\n")
	_rs_sb(&buf, "    return df\n")
	_rs_sb(&buf, "\n")

	// Module wiring
	_rs_sb(&buf, "# Wire mimir.data module\n")
	_rs_sb(&buf, "_data_mod = ModuleType('mimir.data')\n")
	_rs_sb(&buf, "_data_mod.DataFrame = _Data_DataFrame\n")
	_rs_sb(&buf, "_data_mod.Series = _Data_Series\n")
	_rs_sb(&buf, "_data_mod.read_csv = _data_read_csv\n")
	_rs_sb(&buf, "_data_mod.read_json = _data_read_json\n")
	_rs_sb(&buf, "_data_mod.read_parquet = _data_read_parquet\n")
	_rs_sb(&buf, "_data_mod.merge = _data_merge\n")
	_rs_sb(&buf, "sys.modules['mimir.data'] = _data_mod\n")
	_rs_sb(&buf, "\n")

	return string(buf[:])
}

// ==================== mimir.actor ====================

generate_actor_shim :: proc(allocator: mem.Allocator) -> string {
	buf := make([dynamic]u8, 0, 8192, allocator)

	_rs_sb(&buf, "# ---- mimir.actor runtime shim ----\n")
	_rs_sb(&buf, "import threading, queue as _queue_mod\n")
	_rs_sb(&buf, "\n")

	// ---- Actor base class ----
	_rs_sb(&buf, "class _Actor_Base:\n")
	_rs_sb(&buf, "    def __init__(self):\n")
	_rs_sb(&buf, "        self._mailbox = _queue_mod.Queue()\n")
	_rs_sb(&buf, "        self._running = False\n")
	_rs_sb(&buf, "        self._thread = None\n")
	_rs_sb(&buf, "        self._system = None\n")
	_rs_sb(&buf, "\n")
	_rs_sb(&buf, "    def on_receive(self, message):\n")
	_rs_sb(&buf, "        raise NotImplementedError('Actor must implement on_receive')\n")
	_rs_sb(&buf, "\n")
	_rs_sb(&buf, "    def pre_start(self):\n")
	_rs_sb(&buf, "        pass\n")
	_rs_sb(&buf, "\n")
	_rs_sb(&buf, "    def post_stop(self):\n")
	_rs_sb(&buf, "        pass\n")
	_rs_sb(&buf, "\n")
	_rs_sb(&buf, "    def _start(self):\n")
	_rs_sb(&buf, "        self._running = True\n")
	_rs_sb(&buf, "        self._thread = threading.Thread(target=self._run, daemon=True)\n")
	_rs_sb(&buf, "        self._thread.start()\n")
	_rs_sb(&buf, "\n")
	_rs_sb(&buf, "    def _run(self):\n")
	_rs_sb(&buf, "        try:\n")
	_rs_sb(&buf, "            self.pre_start()\n")
	_rs_sb(&buf, "        except Exception:\n")
	_rs_sb(&buf, "            import traceback\n")
	_rs_sb(&buf, "            traceback.print_exc()\n")
	_rs_sb(&buf, "            self._running = False\n")
	_rs_sb(&buf, "            return\n")
	_rs_sb(&buf, "        while self._running:\n")
	_rs_sb(&buf, "            try:\n")
	_rs_sb(&buf, "                item = self._mailbox.get(timeout=0.5)\n")
	_rs_sb(&buf, "            except _queue_mod.Empty:\n")
	_rs_sb(&buf, "                continue\n")
	_rs_sb(&buf, "            if item is None:\n")
	_rs_sb(&buf, "                break\n")
	_rs_sb(&buf, "            msg, future = item\n")
	_rs_sb(&buf, "            try:\n")
	_rs_sb(&buf, "                result = self.on_receive(msg)\n")
	_rs_sb(&buf, "                if future is not None:\n")
	_rs_sb(&buf, "                    future['result'] = result\n")
	_rs_sb(&buf, "                    future['event'].set()\n")
	_rs_sb(&buf, "            except Exception as e:\n")
	_rs_sb(&buf, "                if future is not None:\n")
	_rs_sb(&buf, "                    future['error'] = e\n")
	_rs_sb(&buf, "                    future['event'].set()\n")
	_rs_sb(&buf, "                else:\n")
	_rs_sb(&buf, "                    import traceback\n")
	_rs_sb(&buf, "                    traceback.print_exc()\n")
	_rs_sb(&buf, "                    self._running = False\n")
	_rs_sb(&buf, "                    if self._system is not None:\n")
	_rs_sb(&buf, "                        self._system._on_actor_error(self, e)\n")
	_rs_sb(&buf, "                    break\n")
	_rs_sb(&buf, "        try:\n")
	_rs_sb(&buf, "            self.post_stop()\n")
	_rs_sb(&buf, "        except Exception:\n")
	_rs_sb(&buf, "            import traceback\n")
	_rs_sb(&buf, "            traceback.print_exc()\n")
	_rs_sb(&buf, "\n")
	_rs_sb(&buf, "    def _stop(self):\n")
	_rs_sb(&buf, "        self._running = False\n")
	_rs_sb(&buf, "        self._mailbox.put(None)\n")
	_rs_sb(&buf, "\n")

	// ---- ActorRef ----
	_rs_sb(&buf, "class _Actor_Ref:\n")
	_rs_sb(&buf, "    def __init__(self, actor, init_args=(), init_kwargs=None):\n")
	_rs_sb(&buf, "        self._actor = actor\n")
	_rs_sb(&buf, "        self._init_args = init_args\n")
	_rs_sb(&buf, "        self._init_kwargs = init_kwargs or {}\n")
	_rs_sb(&buf, "\n")
	_rs_sb(&buf, "    def send(self, message):\n")
	_rs_sb(&buf, "        if not self._actor._running:\n")
	_rs_sb(&buf, "            raise RuntimeError('Actor is not running')\n")
	_rs_sb(&buf, "        self._actor._mailbox.put((message, None))\n")
	_rs_sb(&buf, "\n")
	_rs_sb(&buf, "    def ask(self, message, timeout=30.0):\n")
	_rs_sb(&buf, "        if not self._actor._running:\n")
	_rs_sb(&buf, "            raise RuntimeError('Actor is not running')\n")
	_rs_sb(&buf, "        future = {'event': threading.Event(), 'result': None, 'error': None}\n")
	_rs_sb(&buf, "        self._actor._mailbox.put((message, future))\n")
	_rs_sb(&buf, "        if not future['event'].wait(timeout=timeout):\n")
	_rs_sb(&buf, "            raise TimeoutError(f'ask() timed out after {timeout}s')\n")
	_rs_sb(&buf, "        if future['error'] is not None:\n")
	_rs_sb(&buf, "            raise future['error']\n")
	_rs_sb(&buf, "        return future['result']\n")
	_rs_sb(&buf, "\n")
	_rs_sb(&buf, "    def stop(self):\n")
	_rs_sb(&buf, "        self._actor._stop()\n")
	_rs_sb(&buf, "\n")
	_rs_sb(&buf, "    def is_alive(self):\n")
	_rs_sb(&buf, "        return self._actor._running and self._actor._thread is not None and self._actor._thread.is_alive()\n")
	_rs_sb(&buf, "\n")

	// ---- ActorSystem ----
	_rs_sb(&buf, "class _Actor_System:\n")
	_rs_sb(&buf, "    def __init__(self):\n")
	_rs_sb(&buf, "        self._actors = []\n")
	_rs_sb(&buf, "        self._supervised = {}\n")
	_rs_sb(&buf, "        self._lock = threading.Lock()\n")
	_rs_sb(&buf, "        self._supervisor_thread = None\n")
	_rs_sb(&buf, "        self._running = True\n")
	_rs_sb(&buf, "\n")
	_rs_sb(&buf, "    @property\n")
	_rs_sb(&buf, "    def actors(self):\n")
	_rs_sb(&buf, "        with self._lock:\n")
	_rs_sb(&buf, "            return list(self._actors)\n")
	_rs_sb(&buf, "\n")
	_rs_sb(&buf, "    def spawn(self, actor_class, *args, **kwargs):\n")
	_rs_sb(&buf, "        actor = actor_class(*args, **kwargs)\n")
	_rs_sb(&buf, "        if not isinstance(actor, _Actor_Base):\n")
	_rs_sb(&buf, "            raise TypeError(f'{actor_class.__name__} must inherit from Actor')\n")
	_rs_sb(&buf, "        actor._system = self\n")
	_rs_sb(&buf, "        actor._start()\n")
	_rs_sb(&buf, "        ref = _Actor_Ref(actor, init_args=args, init_kwargs=kwargs)\n")
	_rs_sb(&buf, "        with self._lock:\n")
	_rs_sb(&buf, "            self._actors.append(ref)\n")
	_rs_sb(&buf, "        return ref\n")
	_rs_sb(&buf, "\n")
	_rs_sb(&buf, "    def supervise(self, ref, strategy='restart', max_restarts=3, within=60.0):\n")
	_rs_sb(&buf, "        if strategy not in ('restart', 'stop', 'escalate'):\n")
	_rs_sb(&buf, "            raise ValueError(f\"Unknown supervision strategy: '{strategy}'\")\n")
	_rs_sb(&buf, "        with self._lock:\n")
	_rs_sb(&buf, "            self._supervised[id(ref)] = {\n")
	_rs_sb(&buf, "                'ref': ref,\n")
	_rs_sb(&buf, "                'strategy': strategy,\n")
	_rs_sb(&buf, "                'max_restarts': max_restarts,\n")
	_rs_sb(&buf, "                'within': within,\n")
	_rs_sb(&buf, "                'restart_times': [],\n")
	_rs_sb(&buf, "                'actor_class': type(ref._actor),\n")
	_rs_sb(&buf, "            }\n")
	_rs_sb(&buf, "        if self._supervisor_thread is None or not self._supervisor_thread.is_alive():\n")
	_rs_sb(&buf, "            self._supervisor_thread = threading.Thread(target=self._supervisor_loop, daemon=True)\n")
	_rs_sb(&buf, "            self._supervisor_thread.start()\n")
	_rs_sb(&buf, "\n")
	_rs_sb(&buf, "    def _supervisor_loop(self):\n")
	_rs_sb(&buf, "        import time\n")
	_rs_sb(&buf, "        while self._running:\n")
	_rs_sb(&buf, "            time.sleep(0.5)\n")
	_rs_sb(&buf, "            with self._lock:\n")
	_rs_sb(&buf, "                for key, info in list(self._supervised.items()):\n")
	_rs_sb(&buf, "                    ref = info['ref']\n")
	_rs_sb(&buf, "                    if ref.is_alive():\n")
	_rs_sb(&buf, "                        continue\n")
	_rs_sb(&buf, "                    if not self._running:\n")
	_rs_sb(&buf, "                        break\n")
	_rs_sb(&buf, "                    strategy = info['strategy']\n")
	_rs_sb(&buf, "                    if strategy == 'stop':\n")
	_rs_sb(&buf, "                        del self._supervised[key]\n")
	_rs_sb(&buf, "                        continue\n")
	_rs_sb(&buf, "                    if strategy == 'escalate':\n")
	_rs_sb(&buf, "                        del self._supervised[key]\n")
	_rs_sb(&buf, "                        raise RuntimeError(f'Supervised actor {info[\"actor_class\"].__name__} crashed (escalate)')\n")
	_rs_sb(&buf, "                    now = time.time()\n")
	_rs_sb(&buf, "                    times = info['restart_times']\n")
	_rs_sb(&buf, "                    times = [t for t in times if now - t < info['within']]\n")
	_rs_sb(&buf, "                    if len(times) >= info['max_restarts']:\n")
	_rs_sb(&buf, "                        import sys\n")
	_rs_sb(&buf, "                        print(f'Actor {info[\"actor_class\"].__name__} exceeded max restarts ({info[\"max_restarts\"]})', file=sys.stderr)\n")
	_rs_sb(&buf, "                        del self._supervised[key]\n")
	_rs_sb(&buf, "                        continue\n")
	_rs_sb(&buf, "                    times.append(now)\n")
	_rs_sb(&buf, "                    info['restart_times'] = times\n")
	_rs_sb(&buf, "                    actor = info['actor_class'](*ref._init_args, **ref._init_kwargs)\n")
	_rs_sb(&buf, "                    actor._system = self\n")
	_rs_sb(&buf, "                    actor._start()\n")
	_rs_sb(&buf, "                    ref._actor = actor\n")
	_rs_sb(&buf, "\n")
	_rs_sb(&buf, "    def _on_actor_error(self, actor, error):\n")
	_rs_sb(&buf, "        pass\n")
	_rs_sb(&buf, "\n")
	_rs_sb(&buf, "    def shutdown(self, timeout=10.0):\n")
	_rs_sb(&buf, "        self._running = False\n")
	_rs_sb(&buf, "        with self._lock:\n")
	_rs_sb(&buf, "            refs = list(self._actors)\n")
	_rs_sb(&buf, "        for ref in refs:\n")
	_rs_sb(&buf, "            try:\n")
	_rs_sb(&buf, "                ref.stop()\n")
	_rs_sb(&buf, "            except Exception:\n")
	_rs_sb(&buf, "                pass\n")
	_rs_sb(&buf, "        for ref in refs:\n")
	_rs_sb(&buf, "            if ref._actor._thread is not None:\n")
	_rs_sb(&buf, "                ref._actor._thread.join(timeout=timeout / max(len(refs), 1))\n")
	_rs_sb(&buf, "\n")

	// ---- spawn() convenience function ----
	_rs_sb(&buf, "def _actor_spawn(actor_class, *args, **kwargs):\n")
	_rs_sb(&buf, "    actor = actor_class(*args, **kwargs)\n")
	_rs_sb(&buf, "    if not isinstance(actor, _Actor_Base):\n")
	_rs_sb(&buf, "        raise TypeError(f'{actor_class.__name__} must inherit from Actor')\n")
	_rs_sb(&buf, "    actor._start()\n")
	_rs_sb(&buf, "    return _Actor_Ref(actor, init_args=args, init_kwargs=kwargs)\n")
	_rs_sb(&buf, "\n")

	// ---- Module wiring ----
	_rs_sb(&buf, "_actor_mod = ModuleType('mimir.actor')\n")
	_rs_sb(&buf, "_actor_mod.Actor = _Actor_Base\n")
	_rs_sb(&buf, "_actor_mod.ActorRef = _Actor_Ref\n")
	_rs_sb(&buf, "_actor_mod.ActorSystem = _Actor_System\n")
	_rs_sb(&buf, "_actor_mod.spawn = _actor_spawn\n")
	_rs_sb(&buf, "sys.modules['mimir.actor'] = _actor_mod\n")
	_rs_sb(&buf, "\n")

	return string(buf[:])
}

// ==================== Utilities ====================

// Append string to byte buffer (byte-level, no rune truncation).
@(private = "file")
_rs_sb :: proc(buf: ^[dynamic]u8, s: string) {
	for i in 0..<len(s) { append(buf, s[i]) }
}

// Escape a string for embedding in Python single-quoted string literals.
@(private = "file")
_rs_escape_py_str :: proc(s: string) -> string {
	needs_escape := false
	for i in 0..<len(s) {
		c := s[i]
		if c == '\'' || c == '\\' || c == '\n' || c == '\r' || c == 0 {
			needs_escape = true
			break
		}
	}
	if !needs_escape { return s }

	result := make([dynamic]u8, 0, len(s) + 8, context.temp_allocator)
	for i in 0..<len(s) {
		c := s[i]
		switch c {
		case '\'':  append(&result, '\\'); append(&result, '\'')
		case '\\':  append(&result, '\\'); append(&result, '\\')
		case '\n':  append(&result, '\\'); append(&result, 'n')
		case '\r':  append(&result, '\\'); append(&result, 'r')
		case 0:     append(&result, '\\'); append(&result, '0')
		case:       append(&result, c)
		}
	}
	return string(result[:])
}
